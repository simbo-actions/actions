{
  "name": "actions",
  "description": "Simbo's collection of GitHub Actions.",
  "version": "0.0.0",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://github.com/simbo-actions/actions#readme",
  "bugs": "https://github.com/simbo-actions/actions/issues",
  "repository": "github:simbo-actions/actions",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "workspaces": [
    "actions/*",
    "changelog",
    "shared/*",
    "tooling"
  ],
  "type": "module",
  "scripts": {
    "actions-list": "monorepo-packages-list --config=actions-list.config.ts",
    "check": "pnpm run check:format && pnpm run check:boundaries && pnpm run check:spelling && pnpm run check:licenses && pnpm run check:actions && pnpm run check:vulnerabilities",
    "check:actions": "node tooling/bin/check-actions.ts",
    "check:boundaries": "turbo boundaries",
    "check:format": "prettier --check .",
    "check:licenses": "pnpm --recursive --filter \"./actions/*\" exec license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;MIT\" --summary",
    "check:spelling": "cspell",
    "check:vulnerabilities": "osv-scanner scan source --lockfile pnpm-lock.yaml --config osv-scanner.toml --licenses=\"0BSD,Apache-2.0,BlueOak-1.0.0,BSD-2-Clause,BSD-3-Clause,CC-BY-3.0,CC-BY-4.0,CC-BY-SA-4.0,CC0-1.0,ISC,MIT,MPL-2.0,Python-2.0,WTFPL\"",
    "clean": "pnpm run clean:turbo && pnpm run clean:node_modules",
    "clean:node_modules": "rm -rf node_modules",
    "clean:turbo": "rm -rf .turbo",
    "each:build": "turbo run build",
    "each:bundle": "turbo run bundle",
    "each:check": "turbo run check",
    "each:clean": "pnpm run each:clean:dist && pnpm run each:clean:turbo && pnpm run each:clean:node_modules",
    "each:clean:dist": "rm -rf actions/*/dist changelog/dist shared/*/dist",
    "each:clean:node_modules": "rm -rf actions/*/node_modules changelog/node_modules shared/*/node_modules tooling/node_modules",
    "each:clean:turbo": "rm -rf actions/*/.turbo changelog/.turbo shared/*/.turbo tooling/.turbo",
    "each:test": "turbo run test",
    "fix:format": "prettier --log-level=warn --write  .",
    "ncu:latest": "ncu --interactive --target latest --reject='/^(@types/node)$/'",
    "ncu:minor": "ncu --interactive --target minor",
    "ncu:patch": "ncu --interactive --target patch",
    "preflight": "pnpm install --frozen-lockfile && pnpm run each:build && pnpm run each:bundle && pnpm run each:test && pnpm run each:check && pnpm run check && echo 'CvCfn6IgG1sxOzMybUFsbCBDaGVja3MgUGFzc2VkIRtbMG0K' | base64 --decode",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@simbo/commitlint-config": "^2.0.1",
    "@simbo/cspell-config": "^2.1.1",
    "@simbo/monorepo-packages-list-cli": "^2.0.1",
    "@simbo/prettier-config": "^3.0.1",
    "@types/node": "^24.13.6",
    "cspell": "^10.4.1",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^5.0.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "turbo": "^2.11.10"
  }
}

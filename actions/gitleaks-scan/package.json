{
  "name": "gitleaks-scan",
  "description": "A GitHub Action to scan the Git history for secrets with Gitleaks, from a pinned and checksum-verified binary, in one step.",
  "version": "0.0.0",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://github.com/simbo-actions/gitleaks-scan#readme",
  "bugs": "https://github.com/simbo-actions/actions/issues",
  "repository": "github:simbo-actions/actions",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "check": "pnpm run check:types && pnpm run check:eslint",
    "check:eslint": "eslint --max-warnings 0",
    "check:types": "tsc --noEmit",
    "clean": "pnpm run clean:dist && pnpm run clean:coverage",
    "clean:coverage": "rm -rf coverage",
    "clean:dist": "rm -rf dist",
    "test": "vitest run --coverage",
    "test:watch": "vitest dev --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@simbo/stringify-error": "^2.0.0"
  },
  "devDependencies": {
    "@simbo/eslint-config": "^3.0.0",
    "@simbo/rollup-github-actions-config": "^2.0.0",
    "@simbo/tsconfig": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "rollup": "^4.68.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

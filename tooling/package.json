{
  "name": "tooling",
  "description": "Scripts for checks, release, and publish of the simbo-actions monorepo.",
  "version": "0.0.0",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://github.com/simbo-actions/actions/tree/main/tooling#readme",
  "bugs": "https://github.com/simbo-actions/actions/issues",
  "repository": "github:simbo-actions/actions",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "check": "pnpm run check:types && pnpm run check:eslint",
    "check:eslint": "eslint --max-warnings 0",
    "check:types": "tsc --noEmit",
    "clean": "pnpm run clean:coverage",
    "clean:coverage": "rm -rf coverage",
    "test": "vitest run --coverage",
    "test:watch": "vitest dev --coverage"
  },
  "devDependencies": {
    "@simbo/eslint-config": "^3.0.0",
    "@simbo/tsconfig": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}

{
  "name": "@simbo-actions/octokit",
  "description": "Shared Octokit client for the actions of this monorepo, with rate limit handling. Not published.",
  "version": "0.0.0",
  "private": true,
  "author": "Simon Lepel <simbo@simbo.de> (https://simbo.de)",
  "license": "MIT",
  "homepage": "https://github.com/simbo-actions/actions/tree/main/shared/octokit#readme",
  "bugs": "https://github.com/simbo-actions/actions/issues",
  "repository": "github:simbo-actions/actions",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run check:types && pnpm run check:eslint",
    "check:eslint": "eslint --max-warnings 0",
    "check:types": "tsc --noEmit",
    "clean": "pnpm run clean:dist && pnpm run clean:coverage",
    "clean:coverage": "rm -rf coverage",
    "clean:dist": "rm -rf dist",
    "test": "vitest run --coverage",
    "test:watch": "vitest dev --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/plugin-throttling": "^11.0.5"
  },
  "devDependencies": {
    "@simbo/eslint-config": "^3.0.0",
    "@simbo/tsconfig": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
